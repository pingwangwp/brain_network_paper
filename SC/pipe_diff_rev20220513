bval=${PIPE_DIFF_DIR}/bvals
bvec=${PIPE_DIFF_DIR}/bvecs
postfix=`date +%Y-%m-%d-%h-%m-%s-%N`
logpath=${PIPE_DIFF_DIR}/log/pipeline_diff_${postfix}.log
command_records=${PIPE_DIFF_DIR}/log/commands_${postfix}.sh
echo logpath=${logpath%/*}
if [ ! -d ${logpath%/*} ];then
mkdir ${logpath%/*} -p
fi

# echo to file 
echof() {
echo $@ >>$logpath  
echo $@
}

# run and record commands/logs
run() {
echo $@ 
echo $@ >> $command_records
echo $@ >> $logpath
$@ >> $logpath 2>&1
}



