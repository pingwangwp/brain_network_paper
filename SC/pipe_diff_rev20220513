#!/bin/bash
## env setup&check
source ~/.bashrc
chimgen=`dirname $0`
#module add GCC/4.8.5
#module add MPI/openmpi-2.0.2/gcc4.8.5

##############################
#main code
##############################
main ()
{
init_args ${1+"$@"}
run_pipe
exit 0
}

##############################
#initialize arguments
##############################
init_args ()
{
count=0
if [ $# -lt 1 ]; then
    usage
    exit 1
fi
while [ $# -gt 0 ]; do
optname=${1%=*}
optarg=${1##*=}
empty_arg $optname $optarg
  case "$optname" in
        --datain)
                DIFF_orig=$optarg
                shift
                ;;
        --outdir)
                PIPE_DIFF_DIR=$optarg
                shift
                ;;
        --t1dir)
                PIPE_T1_DIR=$optarg
                shift
                ;;
        --t1data)
                T1_orig=$optarg
                shift
                ;;
        --model)
                model=$optarg
                shift
                ;;
        --fibmodel)
                fibmodel=$optarg
                shift
                ;;
        --gradT)
                gradT=$optarg
                shift
		;;
        --pipe)
                pipe=$optarg
                shift
                ;;
	--voxsize)
		voxsize=$optarg
                shift
		;;
        --scale)
                scale=$optarg
                shift
                ;;
        --betthr)
                betthr=$optarg
                shift
                ;;
        *)
                echo "${0}:Unrecognized option \"$1\""
                exit 1
                ;;
        esac
done

if [ -z "$DIFF_orig" ];then
        echo "Error:Missing parameters, datain=$DIFF_orig";
usage
        exit 1
fi

if [ -z "$PIPE_DIFF_DIR" ];then
if [ ${DIFF_orig%/*} = ${DIFF_orig} ];then
PIPE_DIFF_DIR=$PWD
else
PIPE_DIFF_DIR=${DIFF_orig%/*}
fi
fi

if [ -z "$PIPE_T1_DIR" ];then PIPE_T1_DIR="";fi
if [ -z "$T1_orig" ];then T1_orig="";fi
if [ -z "$model" ];then model=dti;fi
if [ -z "$fibmodel" ];then fibmodel=dti;fi
#if [ -z "$gradT" ];then gradT="-iz";fi
if [ -z "$pipe" ];then pipe="full";fi
if [ -z "$voxsize" ];then voxsize="2";fi
if [ -z "$betthr" ];then betthr=0.2;fi
if [ -z "$scale" ];then scale="no";fi
echo --Diffusion original data: $DIFF_orig
echo --Diffusion Pipeline directory: $PIPE_DIFF_DIR
echo --T1 Pipeline directory:$PIPE_T1_DIR
echo --T1 original data:$T1_orig
echo --Diffusion quantification model: $model
echo --Orientation estimation model:$fibmodel
echo --Gradient transform: $gradT
echo --Pipeline name: $pipe
echo --normalize voxsize:$voxsize
}


#############################
#run pipeline
#############################
run_pipe ()
{
##initialize parameters
DIFFname=${DIFF_orig##*/}
DIFF_orig_DIR=${DIFF_orig%/*}
